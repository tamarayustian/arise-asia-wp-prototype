---
export interface Props {
  name: string;
  role: string;
  country?: string;
  imgSrc?: string;
  nameGradient?: string;
}

const { name, role, country, imgSrc, nameGradient } = Astro.props;
---

<div class="flex flex-col items-center gap-2.5 text-center">
  <div
    class="flex aspect-square w-full max-w-45 items-center justify-center overflow-hidden rounded-2xl"
  >
    {
      imgSrc ? (
        <img
          src={imgSrc}
          alt={name}
          class="size-full object-cover"
          loading="lazy"
        />
      ) : (
        <div class="bg-accent-blue-lightest/60 flex size-full items-center justify-center">
          <svg
            class="text-accent-blue-dark size-1/2"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </>
          </svg>
        </div>
      )
    }
  </div>
  <div class="flex flex-col items-center gap-2">
    <p
      class:list={[
        "font-heading text-sm leading-tight font-semibold uppercase",
        nameGradient
          ? `bg-linear-to-r bg-clip-text text-transparent ${nameGradient}`
          : "text-black",
      ]}
    >
      {name}
    </p>
    {
      country && (
        <span class="font-heading rounded-full bg-[#eaeaee] px-2.5 py-0.5 text-xs text-black">
          {country}
        </span>
      )
    }
    <p class="text-xs text-black">{role}</p>
  </div>
</div>
