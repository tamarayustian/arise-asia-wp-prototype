---
import AboutHero from "@/components/about/AboutHero.astro";
import ArticleCard from "@/components/about/ArticleCard.astro";
import Layout from "@/layouts/Layout.astro";

const locale = "en";

const filters = ["All", "News", "Press Releases", "Media Coverage", "Events"];

const articles = [
  { title: "Article Title", source: "Source", href: "#" },
  { title: "Article Title", source: "Source", href: "#" },
  { title: "Article Title", source: "Source", href: "#" },
  { title: "Article Title", source: "Source", href: "#" },
  { title: "Article Title", source: "Source", href: "#" },
  { title: "Article Title", source: "Source", href: "#" },
  { title: "Article Title", source: "Source", href: "#" },
  { title: "Article Title", source: "Source", href: "#" },
  { title: "Article Title", source: "Source", href: "#" },
];
---

<Layout title="Press and Media — Arise Asia" locale={locale!}>
  <section id="hero">
    <AboutHero breadcrumb="ABOUT US/" title="Press and Media">
      <p
        class="font-heading from-primary-red to-primary-orange bg-linear-to-r bg-clip-text text-2xl font-semibold text-transparent uppercase sm:text-3xl md:text-4xl"
      >
        Articles about Arise Asia
      </p>
      <p class="font-heading mt-4 max-w-3xl text-sm md:text-base">
        Arise Asia has been featured across a growing number of publications and
        platforms as this movement continues to gather momentum. Explore recent
        coverage and stories highlighting what God is doing among young people
        across Asia today.
      </p>
    </AboutHero>
  </section>

  <section
    id="articles"
    class="container-page px-8 py-10 md:px-16 lg:px-32 xl:px-48"
  >
    <div class="flex flex-wrap gap-3" id="press-filters">
      {
        filters.map((filter, index) => (
          <button
            type="button"
            class="font-heading data-[active=true]:bg-primary-orange data-[active=false]:border-neutral-cool-primary data-[active=false]:text-neutral-gray-light cursor-pointer rounded-full border px-5 py-2 text-xs font-semibold uppercase transition-colors data-[active=true]:border-transparent data-[active=true]:text-white"
            data-active={index === 0 ? "true" : "false"}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {filter}
          </button>
        ))
      }
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <ArticleCard
            title={article.title}
            source={article.source}
            href={article.href}
          />
        ))
      }
    </div>
  </section>
</Layout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    "#press-filters button",
  );

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      filterButtons.forEach((other) => {
        other.dataset.active = "false";
        other.setAttribute("aria-pressed", "false");
      });
      button.dataset.active = "true";
      button.setAttribute("aria-pressed", "true");
    });
  });
</script>
