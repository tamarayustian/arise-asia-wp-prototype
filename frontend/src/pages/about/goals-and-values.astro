---
import OurGoalSection from "@/components/about/OurGoalSection.astro";
import Layout from "@/layouts/Layout.astro";

const locale = "en";

const values = [
  {
    letter: "A",
    title: "Acquiring the Heart of God",
    description:
      "We ask God to break our hearts for what breaks His, awakening compassion for the people and places across Asia that have yet to encounter His love.",
    color: "border-accent-blue-light text-accent-blue-dark",
  },
  {
    letter: "R",
    title: "Relinquish our Rights",
    description:
      "We surrender our own plans and comforts, trusting God's purposes above our own as we follow Him faithfully today.",
    color: "border-primary-orange text-primary-orange",
  },
  {
    letter: "I",
    title: "Intimacy with God",
    description:
      "We pursue a deep, personal relationship with God through prayer and worship, staying rooted in Him above all else.",
    color: "border-accent-red-light text-[#fe5f5b]",
  },
  {
    letter: "S",
    title: "Sacrificial Living",
    description:
      "We choose to live simply and give generously, laying down comfort so others may experience the love of Christ today.",
    color: "border-accent-purple-light text-accent-purple-primary",
  },
  {
    letter: "E",
    title: "Empowering to Boldly Go",
    description:
      "We equip and release young leaders with courage, sending them to serve in places where they are needed most.",
    color: "border-[#2d80ff] text-[#2d80ff]",
  },
];
---

<Layout title="Our Goal & Values — Arise Asia" locale={locale!}>
  <section id="hero" class="relative overflow-hidden">
    <div
      class="relative flex h-64 flex-col justify-end pb-10 sm:h-80 md:h-96 lg:h-92.25"
      style="background: radial-gradient(circle at 70% 40%, #fff6ef 0%, #ffa45b 15%, #000000 58%);"
    >
      <div
        class="container-page relative flex flex-col px-8 pt-24 md:px-16 lg:px-32 lg:pt-28 xl:px-48"
      >
        <p
          class="font-heading mb-2 text-xl font-semibold tracking-wide text-white uppercase md:text-2xl"
        >
          ABOUT US/
        </p>
        <h1
          class="font-heading text-5xl font-semibold tracking-tight text-white uppercase md:text-[60px]"
        >
          Our Goal & Values
        </h1>
      </div>
    </div>
  </section>

  <section
    id="our-goal"
    class="container-page flex flex-col gap-6 px-8 py-10 md:px-16 lg:px-32 xl:px-48"
  >
    <h2
      class="font-heading from-accent-orange-dark to-primary-orange bg-linear-to-r bg-clip-text text-3xl font-semibold text-transparent uppercase sm:text-4xl md:text-[48px] md:tracking-[-1px]"
    >
      Our Goal
    </h2>
    <OurGoalSection variant="card" showHeading={false} />
    <p class="font-sans text-base leading-[110%] sm:text-lg">
      This goal drives every gathering, every follow-up conversation, and every
      mentoring relationship we build together, as we equip young leaders across
      Asia to respond faithfully and serve wherever they are called today.
    </p>
  </section>

  <section
    id="values"
    class="container-page flex flex-col gap-6 px-8 pb-10 md:px-16 lg:px-32 xl:px-48"
  >
    <h2
      class="font-heading from-accent-orange-dark to-primary-orange bg-linear-to-r bg-clip-text text-3xl font-semibold text-transparent uppercase sm:text-4xl md:text-[48px] md:tracking-[-1px]"
    >
      The Values
    </h2>
    <p class="font-sans text-base leading-[110%] sm:text-lg">
      Our values guide how we live, serve, and lead as a movement, shaping the
      way we walk with young leaders across Asia as they respond to the call to
      serve wherever God places them today.
    </p>
    <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3 lg:grid-cols-5">
      {
        values.map((value) => (
          <div
            class={`flex flex-col items-center justify-between gap-3 rounded-[10px] border-2 p-5 text-center ${value.color}`}
          >
            <p class="font-heading text-5xl font-medium tracking-[-0.2px] uppercase sm:text-6xl">
              {value.letter}
            </p>
            <p class="font-heading text-base font-medium tracking-[-0.2px] sm:text-lg md:text-xl">
              {value.title}
            </p>
            <p class="font-sans text-sm text-black sm:text-base">
              {value.description}
            </p>
          </div>
        ))
      }
    </div>
    <div
      class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-[2fr_1fr_1fr_2fr_1fr]"
    >
      {
        Array.from({ length: 5 }).map((_, i) => (
          <div class="overflow-hidden rounded-[10px]">
            <img
              alt="Arise Asia community"
              class="h-30 w-full object-cover sm:h-40 md:h-52.5"
              src="/images/about-us-bg.png"
            />
          </div>
        ))
      }
    </div>
  </section>
</Layout>
